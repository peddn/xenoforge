{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataFile",
  "description": "A file in `data/rules`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path to the JSON Schema of this file, for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Career"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "$defs": {
    "Career": {
      "description": "A career [p. 38–55].",
      "type": "object",
      "properties": {
        "agendas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cash": {
          "description": "Starting cash, rolled once at creation.",
          "$ref": "#/$defs/Cash"
        },
        "gear": {
          "description": "Starting gear: four lines of \"A or B\"; two items from two different\nlines (F-60) [p. 33].",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/StartItem"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_attribute": {
          "description": "May go to 5 at creation [p. 28].",
          "type": "string"
        },
        "key_skills": {
          "description": "May go to 3 at creation [p. 28].",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "looks": {
          "description": "Suggestions for appearance, signature item and Personal Agenda.\nTheir texts are `<career>.look.<id>`, `<career>.item.<id>` and\n`<career>.agenda.<id>` (A-11).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "names": {
          "description": "Suggested names as in the book [p. 30]; not translated.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "talents": {
          "description": "The three career talents; one is chosen at creation [p. 29, 74].",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "page",
        "key_attribute",
        "key_skills",
        "talents",
        "cash",
        "names",
        "looks",
        "items",
        "agendas",
        "gear"
      ]
    },
    "Cash": {
      "description": "Starting cash: `dice` D6 times `times` dollars.",
      "type": "object",
      "properties": {
        "dice": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "times": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "dice",
        "times"
      ]
    },
    "StartItem": {
      "description": "A starting item: one, `count` of them, or `dice` D6 of them [p. 39–55].",
      "type": "object",
      "properties": {
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "dice": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "item": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "item"
      ]
    }
  }
}
