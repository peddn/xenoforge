{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataFile",
  "description": "A file in `data/rules`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path to the JSON Schema of this file, for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Skill"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "$defs": {
    "Skill": {
      "description": "A skill and the attribute it is based on [p. 58].",
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "no_stunts": {
          "description": "No list of stunts: every success counts for the skill itself,\ne.g. Health back or the bonus of an order (MEDICAL AID, COMMAND)\n[p. 71].",
          "type": "boolean"
        },
        "page": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "page",
        "attribute"
      ]
    }
  }
}
