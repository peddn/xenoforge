{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataFile",
  "description": "A file in `data/rules`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path to the JSON Schema of this file, for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShipSystem"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "$defs": {
    "ActionSlot": {
      "description": "Which action is lost.",
      "type": "string",
      "enum": [
        "slow"
      ]
    },
    "ActorStat": {
      "description": "Values of a character that effects can change.",
      "oneOf": [
        {
          "description": "Full Health, normally STRENGTH [p. 30].",
          "type": "string",
          "const": "health_max"
        },
        {
          "description": "How much a character carries without being encumbered [p. 34, 79].",
          "type": "string",
          "const": "carry_capacity"
        }
      ]
    },
    "Blocked": {
      "description": "Something a restriction or block op forbids.",
      "oneOf": [
        {
          "description": "An action from `actions.json`.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Relieving stress [p. 104].",
          "type": "string",
          "const": "stress_relief"
        },
        {
          "description": "Recovering Health [p. 98].",
          "type": "string",
          "const": "health_recovery"
        }
      ]
    },
    "Change": {
      "description": "How a modifier changes a value.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "integer",
              "format": "int8",
              "maximum": 127,
              "minimum": -128
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "multiply": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "multiply"
          ]
        },
        {
          "type": "object",
          "properties": {
            "divide": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "divide"
          ]
        }
      ]
    },
    "Chooser": {
      "description": "Who chooses.",
      "type": "string",
      "enum": [
        "gm"
      ]
    },
    "Cold": {
      "description": "How cold it is [p. 107].",
      "type": "string",
      "enum": [
        "above_freezing",
        "sub_zero",
        "deep_space"
      ]
    },
    "ColdIntervals": {
      "description": "Roll intervals for Freezing [p. 107].",
      "type": "object",
      "properties": {
        "above_freezing": {
          "$ref": "#/$defs/Unit"
        },
        "deep_space": {
          "$ref": "#/$defs/Unit"
        },
        "sub_zero": {
          "$ref": "#/$defs/Unit"
        }
      },
      "additionalProperties": false,
      "required": [
        "above_freezing",
        "sub_zero",
        "deep_space"
      ]
    },
    "Consumable": {
      "description": "Consumables a character keeps themselves; air and power are in the\nsuit and the device (F-75) [p. 34].",
      "type": "string",
      "enum": [
        "food",
        "water"
      ]
    },
    "Effect": {
      "description": "A continuous effect (plan section 4.4).",
      "oneOf": [
        {
          "description": "Changes the dice pool of rolls or a ship stat.",
          "type": "object",
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/ModTarget"
            },
            "at_least": {
              "description": "The changed value never goes below this, e.g. \"to a minimum of\none die\" [p. 78].",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "change": {
              "$ref": "#/$defs/Change"
            },
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "modifier"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "modifies": {
              "$ref": "#/$defs/Modified"
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "when": {
              "description": "Applies only in a situation the app cannot see, e.g. \"when\nmoving undetected\"; the player ticks it for a roll (A-10).\nTranslation key of the situation.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "applies_to",
            "change"
          ]
        },
        {
          "description": "Forbids an action or a kind of recovery.",
          "type": "object",
          "properties": {
            "blocks": {
              "$ref": "#/$defs/Blocked"
            },
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "restriction"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "$ref": "#/$defs/Target"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "blocks"
          ]
        },
        {
          "description": "Runs operations whenever an event happens.",
          "type": "object",
          "properties": {
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "trigger"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "on": {
              "$ref": "#/$defs/TriggerEvent"
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on",
            "then"
          ]
        },
        {
          "description": "Runs operations on every step of a time unit.",
          "type": "object",
          "properties": {
            "every": {
              "$ref": "#/$defs/Interval"
            },
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "periodic"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "every",
            "then"
          ]
        },
        {
          "description": "Replaces an outcome (\"instead\").",
          "type": "object",
          "properties": {
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "replacement"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "optional": {
              "description": "The player decides whether to use it.",
              "type": "boolean"
            },
            "replaces": {
              "$ref": "#/$defs/Replaceable"
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "uses": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Uses"
                },
                {
                  "type": "null"
                }
              ]
            },
            "with": {
              "$ref": "#/$defs/ReplaceWith"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "replaces",
            "with"
          ]
        },
        {
          "description": "Puts a condition from `conditions.json` on the target.",
          "type": "object",
          "properties": {
            "cold": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cold"
                },
                {
                  "type": "null"
                }
              ]
            },
            "condition": {
              "type": "string"
            },
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "condition"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "unless_wearing": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Gear"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "condition"
          ]
        },
        {
          "description": "Makes an action possible while the source works.",
          "type": "object",
          "properties": {
            "gm_only": {
              "type": "boolean"
            },
            "grants": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "capability"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "$ref": "#/$defs/Target"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "grants"
          ]
        },
        {
          "description": "Shows a note; the game master acts on it.",
          "type": "object",
          "properties": {
            "gm_only": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "hint"
            },
            "lasts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lasts"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "text": {
              "description": "Translation key of the note.",
              "type": "string"
            },
            "tier": {
              "$ref": "#/$defs/HintTier"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text",
            "tier"
          ]
        }
      ]
    },
    "EndEvent": {
      "description": "An event that ends an effect.",
      "oneOf": [
        {
          "description": "Panic stops: COMMAND roll by another, Broken, or one Turn passes [p. 104].",
          "type": "string",
          "const": "panic_stops"
        },
        {
          "description": "The healing time of a critical injury has run out [p. 101].",
          "type": "string",
          "const": "healed"
        },
        {
          "description": "A successful MEDICAL AID roll was made on the character [p. 100].",
          "type": "string",
          "const": "medical_aid"
        },
        {
          "description": "The damaged ship system is repaired [p. 200].",
          "type": "string",
          "const": "repaired"
        },
        {
          "description": "The character is warm again [p. 107].",
          "type": "string",
          "const": "warm"
        },
        {
          "description": "The next change of day (Night to Morning).",
          "type": "string",
          "const": "day_change"
        }
      ]
    },
    "Gear": {
      "description": "Gear that exempts a character from an effect while it is worn.",
      "oneOf": [
        {
          "description": "Any suit that protects in a vacuum; the book says \"pressure suit\"\n[p. 198]. Which items count is ruling F-18.",
          "type": "string",
          "const": "vacuum_suit"
        }
      ]
    },
    "HintTier": {
      "description": "How a hint is shown in the overview (plan section 7.4).",
      "oneOf": [
        {
          "description": "The game master has to act on it.",
          "type": "string",
          "const": "hint"
        },
        {
          "description": "No game consequence.",
          "type": "string",
          "const": "info"
        }
      ]
    },
    "Interval": {
      "description": "How often a periodic effect fires.",
      "oneOf": [
        {
          "description": "Every step of this unit.",
          "type": "object",
          "properties": {
            "step": {
              "$ref": "#/$defs/Unit"
            }
          },
          "additionalProperties": false,
          "required": [
            "step"
          ]
        },
        {
          "description": "Depends on how cold it is.",
          "type": "object",
          "properties": {
            "by_cold": {
              "$ref": "#/$defs/ColdIntervals"
            }
          },
          "additionalProperties": false,
          "required": [
            "by_cold"
          ]
        }
      ]
    },
    "Lasts": {
      "description": "How long an effect lasts.",
      "oneOf": [
        {
          "description": "Only the one-shot operations happen; nothing continues.",
          "type": "string",
          "const": "instant"
        },
        {
          "description": "A number of steps of one time unit.",
          "type": "object",
          "properties": {
            "steps": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0
                },
                "unit": {
                  "$ref": "#/$defs/Unit"
                }
              },
              "additionalProperties": false,
              "required": [
                "unit",
                "count"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "steps"
          ]
        },
        {
          "description": "Until an event happens.",
          "type": "object",
          "properties": {
            "until": {
              "$ref": "#/$defs/EndEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "until"
          ]
        },
        {
          "description": "For good.",
          "type": "string",
          "const": "permanent"
        },
        {
          "description": "As long as the source exists (talent, installed module).",
          "type": "string",
          "const": "while_source"
        }
      ]
    },
    "ModTarget": {
      "description": "What a modifier applies to. At least one list must be filled.",
      "type": "object",
      "properties": {
        "based_on": {
          "description": "Skill rolls based on these attributes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rolls": {
          "description": "Rolls that are not skill rolls.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RollKind"
          }
        },
        "ship_stats": {
          "description": "Ship stats.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShipStat"
          }
        },
        "skills": {
          "description": "Skill rolls with these skills.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stats": {
          "description": "Values of a character.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorStat"
          }
        }
      },
      "additionalProperties": false
    },
    "Modified": {
      "description": "What a modifier changes on the rolls it applies to.",
      "oneOf": [
        {
          "description": "The dice pool (the result for Panic Rolls, the value for ship stats).",
          "type": "string",
          "const": "dice"
        },
        {
          "description": "How often the roll may be pushed [p. 60].",
          "type": "string",
          "const": "pushes"
        }
      ]
    },
    "Op": {
      "description": "A one-shot operation.",
      "oneOf": [
        {
          "description": "Changes the STRESS LEVEL.",
          "type": "object",
          "properties": {
            "delta": {
              "type": "integer",
              "format": "int8",
              "maximum": 127,
              "minimum": -128
            },
            "op": {
              "type": "string",
              "const": "stress"
            },
            "who": {
              "$ref": "#/$defs/Who"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "delta"
          ]
        },
        {
          "description": "Sets the STRESS LEVEL to zero, e.g. Naproleve [p. 137].",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "clear_stress"
            }
          },
          "additionalProperties": false,
          "required": [
            "op"
          ]
        },
        {
          "description": "Changes the Food or Water Supply, e.g. a prefab meal [p. 137].",
          "type": "object",
          "properties": {
            "delta": {
              "type": "integer",
              "format": "int8",
              "maximum": 127,
              "minimum": -128
            },
            "op": {
              "type": "string",
              "const": "supply"
            },
            "supply": {
              "$ref": "#/$defs/Consumable"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "supply",
            "delta"
          ]
        },
        {
          "description": "Deals damage that ignores armor.",
          "type": "object",
          "properties": {
            "amount": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "damage"
            },
            "who": {
              "$ref": "#/$defs/Who"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "amount"
          ]
        },
        {
          "description": "Makes a roll and branches on the result.",
          "type": "object",
          "properties": {
            "on_fail": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              }
            },
            "on_success": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              }
            },
            "op": {
              "type": "string",
              "const": "roll"
            },
            "roll": {
              "$ref": "#/$defs/RollSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "roll"
          ]
        },
        {
          "description": "Makes a Panic Roll.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "panic_roll"
            },
            "who": {
              "$ref": "#/$defs/Who"
            }
          },
          "additionalProperties": false,
          "required": [
            "op"
          ]
        },
        {
          "description": "The next action of this kind is lost.",
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/ActionSlot"
            },
            "op": {
              "type": "string",
              "const": "lose_next_action"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "action"
          ]
        },
        {
          "description": "Drops a weapon or other important item.",
          "type": "object",
          "properties": {
            "chosen_by": {
              "$ref": "#/$defs/Chooser"
            },
            "op": {
              "type": "string",
              "const": "drop_item"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "chosen_by"
          ]
        },
        {
          "description": "Blocks something for a while.",
          "type": "object",
          "properties": {
            "blocks": {
              "$ref": "#/$defs/Blocked"
            },
            "lasts": {
              "$ref": "#/$defs/Lasts"
            },
            "op": {
              "type": "string",
              "const": "block"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "blocks",
            "lasts"
          ]
        },
        {
          "description": "Asks the player or game master a yes/no question.",
          "type": "object",
          "properties": {
            "on_no": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Op"
              }
            },
            "op": {
              "type": "string",
              "const": "ask"
            },
            "question": {
              "description": "Translation key of the question.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "question",
            "on_no"
          ]
        },
        {
          "description": "Shows a note.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "hint"
            },
            "text": {
              "description": "Translation key of the note.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "text"
          ]
        },
        {
          "description": "Calls a named function in the engine for a one-off rule.",
          "type": "object",
          "properties": {
            "handler": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "special"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "handler"
          ]
        }
      ]
    },
    "ReplaceWith": {
      "description": "What happens instead. Each kind of `Replaceable` has one matching kind\nhere (checked by the validation).",
      "oneOf": [
        {
          "description": "For `facehuggers_in_roll`: they count as blank.",
          "type": "string",
          "const": "ignore"
        },
        {
          "description": "For `panic_result`: this entry of `panic.json`.",
          "type": "object",
          "properties": {
            "panic_effect": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "panic_effect"
          ]
        },
        {
          "description": "For `roll`: the roll succeeds with one success.",
          "type": "string",
          "const": "success"
        },
        {
          "description": "For `attribute_for`: roll with this attribute.",
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "attribute"
          ]
        },
        {
          "description": "For `skill`: roll with this skill.",
          "type": "object",
          "properties": {
            "skill": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "skill"
          ]
        }
      ]
    },
    "Replaceable": {
      "description": "What a replacement effect replaces.",
      "oneOf": [
        {
          "description": "All facehugger results (ones on Stress Dice) of a single roll.",
          "type": "string",
          "const": "facehuggers_in_roll"
        },
        {
