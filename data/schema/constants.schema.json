{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataFile",
  "description": "A file in `data/rules`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path to the JSON Schema of this file, for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Constant"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "$defs": {
    "Constant": {
      "description": "A single rule value, such as the most helpers that count [p. 63].",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "page",
        "value"
      ]
    }
  }
}
