    {
      "id": "nightmares",
      "page": 101,
      "d6": 3,
      "effects": [
        {
          "kind": "trigger",
          "on": "sleep",
          "then": [
            {
              "op": "roll",
              "roll": { "attribute": "empathy" },
              "on_success": [
                { "op": "stress", "delta": 1 },
                { "op": "block", "blocks": "stress_relief", "lasts": { "steps": { "unit": "day", "count": 1 } } }
              ]
            }
          ]
        }
      ],
      "ruling": {
        "id": "F-17",
        "alternatives": {
          "on_fail": [
            {
              "kind": "trigger",
              "on": "sleep",
              "then": [
                {
                  "op": "roll",
                  "roll": { "attribute": "empathy" },
                  "on_fail": [
                    { "op": "stress", "delta": 1 },
                    { "op": "block", "blocks": "stress_relief", "lasts": { "steps": { "unit": "day", "count": 1 } } }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
